# Amadeus for Developers — register free at https://developers.amadeus.com
# 1. Create account → "My Self-Service Workspace" → Create App
# 2. Copy Client ID and Client Secret below
# 3. Use AMADEUS_ENV=test for synthetic data, switch to "production" for live prices
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_ENV=test

# DB Hafas (unofficial European rail API — no key needed)
DB_HAFAS_BASE_URL=https://v6.db.transport.rest

# App settings
CACHE_TTL_FLIGHTS=3600
CACHE_TTL_TRAINS=14400
DEFAULT_CURRENCY=GBP
PORT=8000
